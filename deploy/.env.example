# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Domain the app is served from. Only used by the optional Caddy service
# (docker compose --profile caddy); with a host nginx use deploy/nginx-draftfly.conf.
DOMAIN=convert.dim.capital
# Public base URL — used for Stripe webhook registration
APP_BASE_URL=https://convert.dim.capital

# Who may sign in as an operator (comma-separated). Everyone else who signs in
# must be an invited client user, or they get no access at all.
OPERATOR_EMAILS=you@example.com

# Email delivery for sign-in codes (resend.com). Without a key the app still
# works: the code is written to the container log instead of being emailed, so
# `docker compose logs app` is the fallback way in.
#RESEND_API_KEY=
# Must be on a domain verified with Resend. Defaults to Resend's sandbox
# sender, which only delivers to the Resend account owner's own address.
#EMAIL_FROM=DIM Convert <noreply@dim.capital>

# Postgres password for the bundled db service (DATABASE_URL is derived in docker-compose.yml)
POSTGRES_PASSWORD=change-me

# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me

# Slack app credentials (api.slack.com/apps -> Basic Information).
# Only for the approval cards now — sign-in no longer goes through Slack, so
# SLACK_CLIENT_ID/SLACK_CLIENT_SECRET are unused unless you re-add OAuth.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_ID=
# Optional channel for error alerts
#SLACK_ALERT_CHANNEL=

# Claude API key for draft generation
ANTHROPIC_API_KEY=

# Lemlist
LEMLIST_API_KEY=
# Shared secret checked on X-Webhook-Secret header of incoming Lemlist webhooks
LEMLIST_WEBHOOK_SECRET=

# Stripe — self-serve subscriptions. Optional: without STRIPE_SECRET_KEY the app
# runs, self-serve signups get their 3-day trial, and checkout answers
# "payments not enabled". All four are needed for anyone to actually pay.
#   STRIPE_WEBHOOK_SECRET — from a webhook endpoint you create in the Stripe
#     dashboard pointing at https://<your-domain>/api/stripe/webhook, subscribed
#     to checkout.session.completed and customer.subscription.*
#   STRIPE_PRICE_STARTER / STRIPE_PRICE_GROWTH — the recurring price ids
#     (price_...) of the two plans. Only these two prices grant a plan.
#   APP_BASE_URL (above) — where Stripe sends people back to after checkout.
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=
#STRIPE_PRICE_STARTER=
#STRIPE_PRICE_GROWTH=

# Telegram mini-app auth (optional)
#TELEGRAM_BOT_TOKEN=
#ALLOWED_TELEGRAM_USER_IDS=

LOG_LEVEL=info
